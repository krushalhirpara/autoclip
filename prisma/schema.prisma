// AutoClipp - AI Video Clipping SaaS Platform
// Prisma Schema Definition

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum CreditTransactionType {
  PURCHASE
  USAGE
  REFUND
  BONUS
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum VideoStatus {
  UPLOADING
  READY
  PROCESSING
  FAILED
}

enum VideoSourceType {
  UPLOAD
  YOUTUBE
  VIMEO
  S3_URL
}

enum JobType {
  METADATA_EXTRACTION
  AUDIO_EXTRACTION
  TRANSCRIBE
  SPEAKER_DIARIZATION
  ANALYZE
  REFRAME
  RENDER
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ClipAspectRatio {
  VERTICAL_9_16
  SQUARE_1_1
  PORTRAIT_4_5
  LANDSCAPE_16_9
}

enum RenderStatus {
  NOT_STARTED
  RENDERING
  COMPLETED
  FAILED
}

enum CaptionPosition {
  TOP
  CENTER
  BOTTOM
}

enum CaptionAnimationType {
  NONE
  HIGHLIGHT_WORD
  KARAOKE
  POP_IN
  BOUNCE
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  FACEBOOK
  LINKEDIN
  X
  THREADS
  PINTEREST
}

enum PublishStatus {
  DRAFT
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// --------------------------------------------------------
// AUTH & USERS
// --------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription       Subscription?
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  projects           Project[]
  videos             Video[]
  brandKits          BrandKit[]
  captionStyles      CaptionStyle[]
  exports            Export[]
  usageLogs          UsageLog[]
  socialAccounts     SocialAccount[]
  scheduledPosts     ScheduledPost[]
  automationRules    AutomationRule[]
  automationSources  AutomationSource[]

  @@index([email])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(INACTIVE)
  planId               String             @default("free")
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}

model CreditBalance {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance         Int      @default(60) // minutes or credit units
  lifetimeGranted Int      @default(60)
  lifetimeUsed    Int      @default(0)
  updatedAt       DateTime @updatedAt

  transactions CreditTransaction[]

  @@index([userId])
}

model CreditTransaction {
  id              String                @id @default(cuid())
  creditBalanceId String
  creditBalance   CreditBalance         @relation(fields: [creditBalanceId], references: [id], onDelete: Cascade)
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int                   // positive for grant, negative for usage
  type            CreditTransactionType
  description     String?
  metadata        Json?
  createdAt       DateTime              @default(now())

  @@index([userId])
  @@index([creditBalanceId])
}

// --------------------------------------------------------
// PROJECTS & MEDIA
// --------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  videos         Video[]
  clips          Clip[]
  processingJobs ProcessingJob[]

  @@index([userId])
}

model Video {
  id               String      @id @default(cuid())
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  originalFilename String?
  storageKey       String      // S3 or storage object key
  storageUrl       String
  audioStorageKey  String?
  thumbnailUrl     String?
  duration         Float?      // duration in seconds
  width            Int?
  height           Int?
  fps              Float?
  format           String?
  fileSize         BigInt?     // bytes
  status           VideoStatus @default(UPLOADING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  sources        VideoSource[]
  processingJobs ProcessingJob[]
  transcripts    Transcript[]
  clips          Clip[]

  @@index([projectId])
  @@index([userId])
}

model VideoSource {
  id         String          @id @default(cuid())
  videoId    String
  video      Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sourceType VideoSourceType @default(UPLOAD)
  sourceUrl  String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([videoId])
}

// --------------------------------------------------------
// JOBS & WORKFLOWS
// --------------------------------------------------------

model ProcessingJob {
  id          String    @id @default(cuid())
  videoId     String
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        JobType
  status      JobStatus @default(PENDING)
  progress    Int       @default(0) // 0 to 100
  error       String?
  metadata    Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([videoId])
  @@index([projectId])
  @@index([status])
}

// --------------------------------------------------------
// TRANSCRIPTS & SPEAKERS
// --------------------------------------------------------

model Transcript {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  language  String   @default("en")
  rawText   String   @db.Text
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments TranscriptSegment[]
  speakers Speaker[]

  @@index([videoId])
}

model Speaker {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  name         String     @default("Speaker 1")
  label        String     @default("SPEAKER_00")
  speakerIndex Int        @default(0)

  segments TranscriptSegment[]

  @@index([transcriptId])
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  speakerId    String?
  speaker      Speaker?   @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  startTime    Float      // in seconds
  endTime      Float      // in seconds
  text         String     @db.Text
  confidence   Float?
  orderIndex   Int
  words        Json?      // [{word, start, end, score}]

  @@index([transcriptId])
  @@index([speakerId])
  @@index([startTime, endTime])
}

// --------------------------------------------------------
// CLIPS & INTELLIGENCE
// --------------------------------------------------------

model Clip {
  id           String          @id @default(cuid())
  videoId      String
  video        Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startTime    Float           // seconds
  endTime      Float           // seconds
  duration     Float           // seconds
  title        String
  hook         String          @db.Text
  description  String?         @db.Text
  hashtags     String[]        @default([])
  aspectRatio  ClipAspectRatio @default(VERTICAL_9_16)
  status       String          @default("READY")
  renderStatus RenderStatus    @default(NOT_STARTED)
  thumbnailUrl String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  score      ClipScore?
  captions   Caption[]
  renderJobs RenderJob[]
  exports    Export[]
  scheduledPosts ScheduledPost[]

  @@index([videoId])
  @@index([projectId])
}

model ClipScore {
  id                  String   @id @default(cuid())
  clipId              String   @unique
  clip                Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  overallScore        Int      // 0 - 100
  hookStrength        Int      // 0 - 100
  engagementPotential Int      // 0 - 100
  clarity             Int      // 0 - 100
  emotionalImpact     Int      // 0 - 100
  storyCompleteness   Int      // 0 - 100
  reasoning           String?  @db.Text
  createdAt           DateTime @default(now())

  @@index([clipId])
}

model Caption {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  startTime Float
  endTime   Float
  text      String   @db.Text
  wordsJson Json?    // detailed word level timings for animation
  createdAt DateTime @default(now())

  @@index([clipId])
}

model CaptionStyle {
  id              String               @id @default(cuid())
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String               @default("Modern Pop")
  font            String               @default("Inter")
  fontSize        Int                  @default(48)
  textColor       String               @default("#FFFFFF")
  backgroundColor String?              @default("transparent")
  highlightColor  String               @default("#FACC15")
  position        CaptionPosition      @default(BOTTOM)
  animationType   CaptionAnimationType @default(HIGHLIGHT_WORD)
  isDefault       Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId])
}

model BrandKit {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String   @default("Default Brand Kit")
  logoUrl        String?
  primaryColor   String   @default("#7C5CFC")
  secondaryColor String   @default("#A78BFA")
  fontFamily     String   @default("Inter")
  watermarkUrl   String?
  outroUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// --------------------------------------------------------
// RENDERING & EXPORTS
// --------------------------------------------------------

model RenderJob {
  id               String    @id @default(cuid())
  clipId           String
  clip             Clip      @relation(fields: [clipId], references: [id], onDelete: Cascade)
  status           JobStatus @default(PENDING)
  progress         Int       @default(0) // 0 to 100
  outputStorageKey String?
  outputUrl        String?
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  exports Export[]

  @@index([clipId])
  @@index([status])
}

model Export {
  id           String     @id @default(cuid())
  clipId       String
  clip         Clip       @relation(fields: [clipId], references: [id], onDelete: Cascade)
  renderJobId  String?
  renderJob    RenderJob? @relation(fields: [renderJobId], references: [id], onDelete: SetNull)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  format       String     @default("mp4")
  resolution   String     @default("1080x1920")
  downloadUrl  String
  fileSize     BigInt?
  downloadedAt DateTime?
  createdAt    DateTime   @default(now())

  @@index([clipId])
  @@index([userId])
}

// --------------------------------------------------------
// AUDIT & LOGGING
// --------------------------------------------------------

model UsageLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // e.g. "VIDEO_UPLOAD", "TRANSCRIBE", "GENERATE_CLIPS", "RENDER_EXPORT"
  entityType  String?  // "Video", "Clip", "Project"
  entityId    String?
  costCredits Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// --------------------------------------------------------
// SOCIAL PUBLISHING
// --------------------------------------------------------

model SocialAccount {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  accountName    String
  accountId      String?
  accessToken    String?        @db.Text
  refreshToken   String?        @db.Text
  tokenExpiresAt DateTime?
  isConnected    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  scheduledPosts ScheduledPost[]

  @@index([userId])
}

model ScheduledPost {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipId          String
  clip            Clip           @relation(fields: [clipId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  status          PublishStatus  @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  title           String?
  description     String?        @db.Text
  hashtags        String[]       @default([])
  errorMessage    String?        @db.Text
  retryCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  attempts        PublishingAttempt[]

  @@index([userId])
  @@index([clipId])
  @@index([socialAccountId])
  @@index([status])
}

model PublishingAttempt {
  id              String        @id @default(cuid())
  scheduledPostId String
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  status          PublishStatus
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([scheduledPostId])
}

model AutomationRule {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  sourceId       String
  source         AutomationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  targetPlatforms SocialPlatform[]
  clipCount      Int             @default(5)
  enableCaptions Boolean         @default(true)
  reframe        ClipAspectRatio @default(VERTICAL_9_16)
  aiTitle        Boolean         @default(true)
  aiDescription  Boolean         @default(true)
  autoApprove    Boolean         @default(false)
  scheduleTimes  String[]        @default(["09:00", "13:00", "18:00"])
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

model AutomationSource {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  channelName    String
  channelId      String?
  lastCheckedAt  DateTime?
  lastVideoId    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  rules          AutomationRule[]

  @@index([userId])
}
